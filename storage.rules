rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public media (notices, gallery, projects) can be read by anyone
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Citizen grievance uploads: file size limit 5MB, image only
    match /complaints/{complaintId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if request.auth != null;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
