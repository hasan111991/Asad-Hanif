        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 220 },
        "fiscalYear": { "type": "string", "maxLength": 20 },
        "fundingSource": {
          "type": "string",
          "enum": [
            "Punjab Government",
            "Federal Government",
            "Municipal Funds",
            "Departmental Maintenance Budget",
            "Corporate CSR",
            "Registered Welfare Organizations",
            "Public-Private Partnership",
            "Other Verified Sources"
          ]
        },
        "fundingStage": { "type": "string", "enum": ["Proposed", "Requested", "Approved", "Released", "Expended"] },
        "amountPkr": { "type": "number" },
        "sector": { "type": "string", "maxLength": 120 },
        "evidenceRef": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "fiscalYear", "fundingSource", "fundingStage", "amountPkr"]
    },
    "CityDepartment": {
      "title": "CityDepartment",
      "description": "Municipal or provincial coordination department directory record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 180 },
        "jurisdiction": { "type": "string", "maxLength": 240 },
        "focalPerson": { "type": "string", "maxLength": 140 },
        "contactPhone": { "type": "string", "maxLength": 40 },
        "officeAddress": { "type": "string", "maxLength": 240 },
        "isIndependentControlDisclaimer": { "type": "boolean" }
      },
      "required": ["name", "jurisdiction"]
    },
    "CityComplaint": {
      "title": "CityComplaint",
      "description": "Municipal citizen complaint ticket keyed by Tracking ID.",
      "type": "object",
      "properties": {
        "trackingId": { "type": "string", "pattern": "^CITY-[0-9]{4}-[A-Za-z0-9]{3,8}$", "maxLength": 40 },
        "citizenName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 24 },
        "locality": { "type": "string", "minLength": 2, "maxLength": 160 },
        "category": {
          "type": "string",
          "enum": [
            "Garbage",
            "Sewerage",
            "Roads",
            "Drinking Water",
            "Streetlights",
            "Traffic",
            "Parks",
            "Public Facilities",
            "Encroachment",
            "Other Municipal Issues"
          ]
        },
        "description": { "type": "string", "minLength": 8, "maxLength": 2500 },
        "status": {
          "type": "string",
          "enum": [
            "Submitted",
            "Under Review",
            "Assigned",
            "In Progress",
            "Awaiting Verification",
            "Resolved",
            "Reopened",
            "Rejected"
          ]
        },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["trackingId", "citizenName", "phone", "locality", "category", "description", "status", "createdAt", "updatedAt"]
    },
    "CitySurvey": {
      "title": "CitySurvey",
      "description": "Mobile field survey record with GPS coordinates and condition grading.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "sector": { "type": "string", "maxLength": 120 },
        "locality": { "type": "string", "maxLength": 160 },
        "conditionGrade": { "type": "string", "enum": ["Excellent", "Good", "Average", "Poor", "Critical"] },
        "repairRecommendation": { "type": "string", "maxLength": 1500 },
        "officerName": { "type": "string", "maxLength": 140 },
        "verificationStatus": { "type": "string", "enum": ["Draft", "Pending Verification", "Verified"] },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "sector", "conditionGrade", "officerName", "createdAt"]
    },
    "CityInspection": {
      "title": "CityInspection",
      "description": "Site verification inspection attached to projects, sanitation routes, or utilities.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "maxLength": 80 },
        "targetId": { "type": "string", "maxLength": 128 },
        "inspectorName": { "type": "string", "maxLength": 140 },
        "findings": { "type": "string", "maxLength": 1500 },
        "outcome": { "type": "string", "enum": ["Passed", "Action Required", "Failed"] },
        "inspectedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["targetType", "targetId", "inspectorName", "outcome", "inspectedAt"]
    },
    "CityReport": {
      "title": "CityReport",
      "description": "Generated municipal performance report with metadata and publish status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reportType": { "type": "string", "maxLength": 120 },
        "title": { "type": "string", "maxLength": 220 },
        "period": { "type": "string", "maxLength": 80 },
        "dataSource": { "type": "string", "maxLength": 160 },
        "department": { "type": "string", "maxLength": 160 },
        "verificationStatus": { "type": "string", "enum": ["Draft", "Verified", "Provisional"] },
        "isPublished": { "type": "boolean" },
        "summary": { "type": "string", "maxLength": 3000 },
        "lastUpdated": { "type": "string", "maxLength": 64 }
      },
      "required": ["reportType", "title", "period", "dataSource", "verificationStatus", "isPublished", "lastUpdated"]
    },
    "CityNotice": {
      "title": "CityNotice",
      "description": "Public municipal advisory or development tender notice.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 240 },
        "category": { "type": "string", "maxLength": 100 },
        "publishDate": { "type": "string", "maxLength": 40 },
        "description": { "type": "string", "maxLength": 3000 },
        "isPublished": { "type": "boolean" }
      },
      "required": ["title", "publishDate", "description", "isPublished"]
    },
    "CityAuditLog": {
      "title": "CityAuditLog",
      "description": "Immutable City Management CRUD and financial mutation audit entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 160 },
        "module": { "type": "string", "maxLength": 80 },
        "actorEmail": { "type": "string", "maxLength": 160 },
        "details": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["action", "module", "actorEmail", "details", "timestamp"]
    }
  },
