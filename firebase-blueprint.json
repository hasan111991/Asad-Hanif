        "longitude": { "type": "number" }
      },
      "required": ["title", "category", "status", "budget", "progressPercent", "latitude", "longitude"]
    },
    "AssemblyActivity": {
      "title": "AssemblyActivity",
      "description": "Punjab Provincial Assembly legislative questions, bills, committee participation, and notices.",
      "type": "object",
