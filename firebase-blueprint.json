{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrative staff member with role-based access control.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "role": {
          "type": "string",
          "enum": [
            "Super Admin",
            "Admin",
            "City Manager",
            "Department Manager",
            "Field Officer",
            "Finance Officer",
            "Office Manager",
            "Project Manager",
            "Media Manager",
            "Data Entry Operator"
          ]
        },
        "status": { "type": "string", "enum": ["Active", "Suspended"] },
        "phone": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "lastLogin": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "displayName", "role", "status", "createdAt"]
    },
    "LeaderProfile": {
