        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 3, "maxLength": 240 },
        "titleUrdu": { "type": "string", "maxLength": 240 },
        "category": {
          "type": "string",
          "enum": [
            "Question Raised",
