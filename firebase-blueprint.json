        "summaryUrdu": { "type": "string", "maxLength": 3000 },
        "imageUrl": { "type": "string", "maxLength": 150000 },
        "videoUrl": { "type": "string", "maxLength": 500000 },
        "status": { "type": "string", "maxLength": 80 }
      },
      "required": ["title", "category", "sessionDate", "summary"]
    },
    "NewsItem": {
      "title": "NewsItem",
      "description": "Constituency news, press releases, and public outreach statements.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 3, "maxLength": 260 },
