        "department": { "type": "string", "maxLength": 160 },
        "departmentUrdu": { "type": "string", "maxLength": 160 },
        "budget": { "type": "string", "maxLength": 100 },
        "startDate": { "type": "string", "maxLength": 40 },
        "completionDate": { "type": "string", "maxLength": 40 },
